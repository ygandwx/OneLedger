{
  "name": "oneledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "db:deploy": "node --env-file-if-exists=.env scripts/prepare-db.mjs && prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@tanstack/react-table": "^8.21.3",
    "decimal.js": "^10.6.0",
    "next": "16.4.6",
    "node-cron": "^4.2.1",
    "otpauth": "^9.4.1",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
  }
}
